{
    "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
    "schema_version": "v2.4",
    "name_for_human": "ServiceNow Assistant",
    "description_for_human": "Browse the ServiceNow catalog, manage requests, and report & track IT incidents from Microsoft 365 Copilot.",
    "contact_email": "publisher-email@example.com",
    "namespace": "servicenowcatalog",
    "functions": [],
    "runtimes": [
        {
            "type": "RemoteMCPServer",
            "spec": {
                "url": "${{MCP_SERVER_URL}}"
            },
            "run_for_functions": [
                "*"
            ],
            "auth": {
                "type": "OAuthPluginVault",
                "reference_id": "${{MCP_DA_AUTH_ID_FUNCYJ453F}}"
            }
        }
    ]
}
