{
  "name": "servicenow-mcp-apps-copilot",
  "version": "1.1.6",
  "description": "Stateless ServiceNow Service Catalog MCP server on Azure Functions, delivering MCP Apps (SEP-1865) widgets to Microsoft 365 Copilot",
  "private": true,
  "license": "MIT",
  "author": "Pavel Vecer",
  "main": "dist/functions/*.js",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pavecer/servicenow-mcp-apps-copilot.git"
  },
  "bugs": {
    "url": "https://github.com/pavecer/servicenow-mcp-apps-copilot/issues"
  },
  "homepage": "https://github.com/pavecer/servicenow-mcp-apps-copilot#readme",
  "scripts": {
    "build:widgets": "node scripts/dev/build-widgets.mjs",
    "prebuild": "npm run build:widgets",
    "build": "tsc -p .",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "deploy:azure": "pwsh -File scripts/deploy-azure.ps1",
    "start:standalone": "npm run build && node dist/server.js",
    "start": "func start",
    "start:dev": "npm run build && func start",
    "smoke:test": "node scripts/smoke-test.mjs",
    "validate:live": "node scripts/dev/validate-live-tools.mjs",
    "release:check": "node scripts/dev/release-governance.mjs check",
    "release:pr-check": "node scripts/dev/release-governance.mjs pr-check",
    "release:plan": "node scripts/dev/release-governance.mjs plan",
    "release:prepare": "node scripts/dev/release-governance.mjs prepare",
    "release:notes": "node scripts/dev/release-governance.mjs notes",
    "release:auto": "node scripts/dev/release-automate.mjs",
    "release:publish": "node scripts/dev/release-automate.mjs --publish",
    "demo:seed": "node scripts/dev/seed-approval-demo.mjs seed --confirm",
    "demo:verify": "node scripts/dev/seed-approval-demo.mjs verify",
    "demo:cleanup": "node scripts/dev/seed-approval-demo.mjs cleanup --confirm",
    "sn:local": "npm run build && node scripts/dev/test-servicenow-local.mjs",
    "preflight:readiness": "node scripts/dev/preflight-readiness.mjs",
    "codespaces:configure": "node .devcontainer/scripts/configure-codespaces.mjs",
    "cloud:check": "node .devcontainer/scripts/configure-codespaces.mjs --strict && node .devcontainer/scripts/check-cloud-readiness.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest": "npm run build:widgets"
  },
  "dependencies": {
    "@azure/functions": "^4.16.2",
    "@azure/msal-node": "^5.3.0",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "express": "^5.2.1",
    "serverless-http": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.12.18",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.4.0",
    "form-data": "^4.0.6",
    "jose": "^6.2.8",
    "tinyexec": "^1.3.0",
    "tinyglobby": "^0.2.17",
    "ast-v8-to-istanbul": "^1.0.5"
  }
}
